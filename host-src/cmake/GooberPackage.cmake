# goober_package(NAME <name> SOURCES ... DEPS ... TESTS ...)
# Declares the library goober_<name> from packages/<name>, and one test binary
# goober_<name>_test registered with CTest.
function(goober_package)
  cmake_parse_arguments(P "" "NAME" "SOURCES;DEPS;TESTS;TEST_DEPS" ${ARGN})
  set(target goober_${P_NAME})
  if(P_SOURCES)
    add_library(${target} STATIC ${P_SOURCES})
    target_include_directories(${target} PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/include")
    target_link_libraries(${target} PUBLIC ${P_DEPS})
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic)
  else()
    add_library(${target} INTERFACE)
    target_include_directories(${target} INTERFACE "${CMAKE_CURRENT_SOURCE_DIR}/include")
    target_link_libraries(${target} INTERFACE ${P_DEPS})
  endif()
  if(BUILD_TESTING AND P_TESTS)
    add_executable(${target}_test ${P_TESTS})
    target_link_libraries(${target}_test PRIVATE ${target} ${P_TEST_DEPS} GTest::gtest_main)
    target_compile_options(${target}_test PRIVATE -Wall -Wextra)
    target_compile_definitions(${target}_test PRIVATE GOOBER_TEST_TMP="${CMAKE_BINARY_DIR}/test-tmp")
    include(GoogleTest)
    gtest_discover_tests(${target}_test DISCOVERY_MODE PRE_TEST)
  endif()
endfunction()
