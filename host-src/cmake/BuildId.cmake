# Writes OUT with the git commit the build came from, "+dirty" when the tree had changes,
# rewriting it only when that changed (so a build without changes recompiles nothing).
execute_process(COMMAND git -C "${SRC}" rev-parse --short=12 HEAD OUTPUT_VARIABLE commit
                OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR commit STREQUAL "")
  set(commit "unknown")
endif()
execute_process(COMMAND git -C "${SRC}" status --porcelain --untracked-files=no OUTPUT_VARIABLE changes
                ERROR_QUIET)
if(NOT changes STREQUAL "")
  set(commit "${commit}+dirty")
endif()
set(text "#pragma once\n// Generated by cmake/BuildId.cmake: the commit this binary was built from.\ninline constexpr const char* kBuildCommit = \"${commit}\";\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
  file(WRITE "${OUT}" "${text}")
endif()
