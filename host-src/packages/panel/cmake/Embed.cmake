# Writes OUT, a C++ file holding every file in DIR as bytes, with its content type (from its
# extension) and a SHA-256 ETag, for goober::panel::find. index.html is served at "/".
file(GLOB files RELATIVE "${DIR}" "${DIR}/*")
list(SORT files)
set(body "// Generated by packages/panel/cmake/Embed.cmake from packages/panel/assets/; edit those instead.\n")
string(APPEND body "#include \"goober/panel/assets.h\"\n\nnamespace goober::panel {\nnamespace {\n")
set(table "")
set(i 0)
foreach(name IN LISTS files)
  set(file "${DIR}/${name}")
  if(name MATCHES "\\.html$")
    set(type "text/html; charset=utf-8")
  elseif(name MATCHES "\\.css$")
    set(type "text/css; charset=utf-8")
  elseif(name MATCHES "\\.js$")
    set(type "text/javascript; charset=utf-8")
  elseif(name MATCHES "\\.svg$")
    set(type "image/svg+xml")
  else()
    message(FATAL_ERROR "panel asset ${name}: no content type for its extension")
  endif()
  if(name STREQUAL "index.html")
    set(url "/")
  else()
    set(url "/${name}")
  endif()
  file(READ "${file}" hex HEX)
  file(SHA256 "${file}" sha)
  string(SUBSTRING "${sha}" 0 16 tag)
  string(LENGTH "${hex}" hexlen)
  math(EXPR size "${hexlen} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(APPEND body "const unsigned char k${i}[] = {${bytes}0};\n")
  string(APPEND table "    {\"${url}\", \"${type}\", std::string_view(reinterpret_cast<const char*>(k${i}), ${size}), \"\\\"${tag}\\\"\"},\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND body "const Asset kAssets[] = {\n${table}};\n}  // namespace\n\n")
string(APPEND body "const Asset* find(std::string_view path) {\n  for (const auto& a : kAssets) {\n    if (a.path == path) return &a;\n  }\n  return nullptr;\n}\n\n}  // namespace goober::panel\n")
file(WRITE "${OUT}.tmp" "${body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
