{
  "schema": "leads1",
  "tables": {
    "leads": {
      "columns": {
        "id": { "type": "int64", "primary-key": true },
        "campaign": { "type": "string", "max-length": 64 },
        "email": { "type": "string", "max-length": 254 },
        "name": { "type": "string", "max-length": 200, "nullable": true },
        "answers": { "type": "string", "max-length": 64000, "default": "{}" },
        "utm_source": { "type": "string", "max-length": 200, "nullable": true },
        "utm_medium": { "type": "string", "max-length": 200, "nullable": true },
        "utm_campaign": { "type": "string", "max-length": 200, "nullable": true },
        "utm_content": { "type": "string", "max-length": 200, "nullable": true },
        "client_key": { "type": "string", "max-length": 32, "nullable": true },
        "token": { "type": "string", "max-length": 64 },
        "confirmed_ms": { "type": "int64", "nullable": true },
        "created_ms": { "type": "int64" },
        "updated_ms": { "type": "int64" }
      },
      "indexes": {
        "leads_by_campaign_email": { "columns": ["campaign", "email"], "unique": true },
        "leads_by_token": { "columns": ["token"], "unique": true },
        "leads_by_created": { "columns": ["created_ms"] }
      }
    }
  }
}
